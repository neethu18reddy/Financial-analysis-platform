# ==============================================================================
# AI-POWERED FUNDAMENTAL ANALYSIS & FINANCIAL DECISION INTELLIGENCE PLATFORM
# Environment Configuration Template
# NOTE: DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Indian Equities Fundamental Analysis Platform"
VERSION=0.1.0
API_V1_STR=/api/v1

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
# Default: SQLite for local development. For PostgreSQL set:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_analysis
DATABASE_URL=sqlite+aiosqlite:///./financial_analysis.db
DATABASE_SYNC_URL=sqlite:///./financial_analysis.db
DB_ECHO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI / LLM Provider Configuration (Locked for Phase 0 - Foundation only)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
